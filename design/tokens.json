{
  "version": "1.0.0",
  "status": "design-spec-not-runtime-implementation",
  "updatedAt": "2026-11-13",
  "color": {
    "background": "#FFFFFF",
    "text": "#141414",
    "secondary": "#6B6B70",
    "action": "#5146E5",
    "actionPressed": "#4338CA",
    "onAction": "#FFFFFF",
    "separator": "#E7E7EB",
    "pressedSurface": "#F5F5F7",
    "error": "#B42318",
    "success": "#187148",
    "focus": "#5146E5",
    "photoTextLight": "#FFFFFF",
    "photoTextDark": "#141414"
  },
  "font": {
    "ios": [
      "system-ui",
      "PingFang SC"
    ],
    "android": [
      "system-ui",
      "Noto Sans CJK SC",
      "sans-serif"
    ],
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "styles": {
      "body": {
        "size": 17,
        "lineHeight": 24,
        "weight": 400
      },
      "action": {
        "size": 17,
        "lineHeight": 24,
        "weight": 500
      },
      "group": {
        "size": 17,
        "lineHeight": 24,
        "weight": 600
      },
      "meta": {
        "size": 13,
        "lineHeight": 18,
        "weight": 400
      },
      "nav": {
        "size": 12,
        "lineHeight": 16,
        "weight": 400
      },
      "countdown": {
        "size": 96,
        "lineHeight": 104,
        "weight": 300,
        "tabularNumbers": true
      }
    },
    "dynamicType": true
  },
  "space": {
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32
    ],
    "pageGutter": 20,
    "sectionGap": 32,
    "groupGap": 12,
    "photoGap": 2
  },
  "radius": {
    "photo": 0,
    "button": 4,
    "input": 4,
    "list": 0,
    "card": 0
  },
  "border": {
    "photo": 0,
    "container": 0,
    "separator": 1,
    "focus": 2
  },
  "shadow": {
    "default": "none"
  },
  "layout": {
    "referenceViewport": {
      "width": 390,
      "height": 844,
      "unit": "logical"
    },
    "minimumScreenWidth": 320,
    "bottomNavHeight": 64,
    "rowMinHeight": 56,
    "primaryButtonHeight": 48,
    "minTouchTarget": {
      "iosPt": 44,
      "androidDp": 48
    },
    "safeArea": "system-insets",
    "photoGridColumns": 3
  },
  "motion": {
    "pressMs": 100,
    "transitionMs": 180,
    "photoColorSwitchMs": 0,
    "reducedMotion": true
  },
  "rules": {
    "pageTitle": false,
    "descriptiveParagraph": false,
    "decorativeGradient": false,
    "nestedCards": false,
    "standaloneCards": false,
    "photoBorders": false,
    "buttonPill": false,
    "necessaryStatusText": true,
    "sectionLabels": true,
    "actionLabels": true
  },
  "photoText": {
    "sample": "rendered-crop-per-text-block",
    "candidates": [
      "#141414",
      "#FFFFFF"
    ],
    "targetContrast": 4.5,
    "largeTextMinimum": 3,
    "recalculateOn": [
      "photo-change",
      "crop-change",
      "text-position-change",
      "layout-change",
      "text-size-change"
    ],
    "fallback": "local-scrim-and-recheck",
    "scrimMaxOpacity": 1,
    "shadowOnlyIsInsufficient": true
  },
  "state": {
    "photoPermission": [
      "none",
      "selected",
      "full"
    ],
    "original": [
      "available",
      "needs-download",
      "missing"
    ],
    "grouping": [
      "pending",
      "confirmed"
    ],
    "transfer": [
      "pairing",
      "awaiting-acceptance",
      "transferring",
      "paused",
      "verified",
      "failed"
    ],
    "importDefault": "preview-then-merge"
  }
}
